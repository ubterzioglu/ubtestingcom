# Copy to .env.local and fill in the values from the Supabase dashboard
# (Project Settings → API, and Project Settings → Database for the connection string).

# Client-side. Vite inlines every VITE_* value into the JS bundle — publishable key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. No VITE_ prefix — these must never reach the browser.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Pooler hosts, not db.<project-ref>.supabase.co — the direct host is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_POOL_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_ACCESS_TOKEN=sbp_...

# Legacy JWT keys, only for tools that still expect the old format.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
